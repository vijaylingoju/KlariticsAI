# Copy to .env for local development. Never commit .env.
ENV=development
PORT=8080
LOG_LEVEL=debug
LOG_FORMAT=console
# The seeded event store (make seed writes it).
STORE_PATH=data/klaritics.duckdb
# Bearer token for the MCP server's HTTP transport (make mcp-http, docker compose).
MCP_HTTP_TOKEN=change-me
MCP_HTTP_PORT=8090
# Model calls (OpenRouter, Claude Haiku 4.5). live calls the API; record also saves
# each answer under LLM_RECORDINGS_DIR; replay serves saved answers only (CI).
LLM_MODE=live
OPENROUTER_API_KEY=
LLM_RECORDINGS_DIR=evals/recordings
LLM_LEDGER_PATH=data/llm_ledger.jsonl
LLM_BUDGET_USD=8
# Switch one model feature off: LLM_KILL_INTENT_PARSE, LLM_KILL_INVESTIGATE, LLM_KILL_NARRATE.
# Saved reports.
REPORTS_DIR=data/reports
# Tracing is off until this is set (OTLP over HTTP, e.g. http://localhost:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=
